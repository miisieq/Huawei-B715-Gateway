ROUTER_USER=admin
ROUTER_PASS=haslo_z_naklejki_na_routerze
ROUTER_IP=192.168.0.1

# Limity czasu połączenia z routerem w sekundach (float). Chronią przed zawieszeniem,
# gdy router nie przyjmuje połączeń. Domyślnie connect=3, read=5.
ROUTER_CONNECT_TIMEOUT=3
ROUTER_READ_TIMEOUT=5

# Konfiguracja Pushover (dla scripts/sms_to_pushover.py)
PUSHOVER_TOKEN=token_aplikacji_pushover
PUSHOVER_USER=klucz_uzytkownika_pushover

# Opcjonalnie: nadawcy pomijani przy powiadomieniach (lista rozdzielona przecinkami).
# Dopasowanie po numerze telefonu lub — dla wiadomości bez numeru (np. marketing) —
# po nazwie nadawcy. Bez rozróżniania wielkości liter.
# SMS_IGNORE_SENDERS=ALERT RCB

# Restart routera (dla scripts/reboot_router.py) — wszystkie opcjonalne.
# Odstęp między próbami i maksymalny łączny czas ponawiania (sekundy).
REBOOT_RETRY_INTERVAL=20
REBOOT_MAX_DURATION=900
# Powiadomienie Pushover o udanym restarcie (porażkę zgłasza zawsze). 0 = wyłącz.
REBOOT_NOTIFY_SUCCESS=1
